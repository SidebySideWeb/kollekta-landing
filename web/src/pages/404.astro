---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getNotFoundPage, getSiteSettings } from '../lib/queries';
import { fetchWithFallback } from '../lib/fetch-with-fallback';
import { defaultNotFoundPage, defaultSiteSettings } from '../lib/fallbacks';

const settings = {
  ...defaultSiteSettings,
  ...(await fetchWithFallback(() => getSiteSettings(), null, 'siteSettings')),
};

const page = {
  ...defaultNotFoundPage,
  ...(await fetchWithFallback(() => getNotFoundPage(), null, 'notFoundPage')),
};
---

<BaseLayout
  title={page.seo?.title || 'Η σελίδα δεν βρέθηκε — Kollekta'}
  description={page.seo?.description || page.description}
  settings={settings}
  headerVariant="minimal"
  footerVariant="minimal"
  homePrefix="/"
  noIndex={true}
>
  <main>
    <div class="wrap">
      <section class="error-section">
        <div class="error-grid">
          <div>
            <div class="error-code">{page.codeLabel || 'Σφάλμα 404'}</div>
            <h1>{page.title || 'Αυτό το καρέ δεν βγήκε.'}</h1>
            <p class="lede">
              {page.description ||
                'Η σελίδα που ψάχνεις δεν υπάρχει πια, ή ο σύνδεσμος έχει κάποιο λάθος. Το υπόλοιπο φιλμ είναι εντάξει, υπόσχομαι.'}
            </p>
            <div class="error-ctas">
              <a href="/" class="btn btn-primary">{page.primaryCtaLabel || 'Πίσω στην αρχική'}</a>
              <a href="/#interest" class="btn btn-ghost">{page.secondaryCtaLabel || 'Επικοινωνία'}</a>
            </div>
          </div>
          <div class="mock" style="transform:rotate(-1.6deg); max-width:380px; margin:0 auto;">
            <div class="mock-bar">
              <div class="mock-dots"><span></span><span></span><span></span></div>
              <div class="mock-label">404</div>
            </div>
            <div class="tile-grid">
              <div class="tile"></div>
              <div class="tile missing"><span>?</span></div>
              <div class="tile"></div>
              <div class="tile"></div>
              <div class="tile"></div>
              <div class="tile"></div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
