---
import type { HomePage } from '../../lib/types';

interface Props {
  home: HomePage;
}

const { home } = Astro.props;
---

<section id="how-it-works" class="py-20 md:py-28 px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto border-t border-slate-hairline/60">
  <div class="text-center max-w-2xl mx-auto mb-16">
    {
      home.solutionEyebrow && (
        <span class="text-xs font-bold text-cobalt-blue uppercase tracking-widest block mb-3">
          {home.solutionEyebrow}
        </span>
      )
    }
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-deep-slate tracking-tight">
      {home.solutionTitle ?? ''}
    </h2>
  </div>

  <div class="relative">
    <div class="hidden md:block absolute top-10 left-[15%] right-[15%] h-[2px] bg-slate-200 z-0"></div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative z-10">
      {
        (home.solutionSteps ?? []).map((step) => (
          <div class="bg-white md:bg-transparent p-6 md:p-0 rounded-2xl border md:border-none border-slate-hairline flex flex-col items-center text-center">
            <div class="w-20 h-20 rounded-2xl bg-white border border-slate-hairline shadow-sm flex items-center justify-center text-3xl font-extrabold text-cobalt-blue mb-6 font-mono">
              {step.number ?? ''}
            </div>
            <h3 class="text-lg font-bold text-deep-slate mb-2">{step.title ?? ''}</h3>
            <p class="text-sm text-body-ink leading-relaxed max-w-xs">{step.description ?? ''}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
