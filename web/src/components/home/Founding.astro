---
import type { HomePage } from '../../lib/types';

interface Props {
  home: HomePage;
}

const { home } = Astro.props;
---

<section style="background:var(--paper-dim);">
  <div class="wrap founding reveal">
    {home.foundingEyebrow && <div class="eyebrow">{home.foundingEyebrow}</div>}
    {home.foundingTitle && <h2 class="h2">{home.foundingTitle}</h2>}
    {
      home.foundingDescription && (
        <p class="lede" style="margin:18px auto 0;">
          {home.foundingDescription}
        </p>
      )
    }
  </div>
</section>
