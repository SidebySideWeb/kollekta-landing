---
import type { HomePage } from '../../lib/types';

interface Props {
  home: HomePage;
}

const { home } = Astro.props;
---

<section>
  <div class="wrap">
    {home.whiteLabelEyebrow && <div class="eyebrow reveal">{home.whiteLabelEyebrow}</div>}
    {home.whiteLabelTitle && <h2 class="h2 reveal">{home.whiteLabelTitle}</h2>}
    {
      home.whiteLabelDescription && (
        <p class="lede reveal" style="margin-top:14px;">
          {home.whiteLabelDescription}
        </p>
      )
    }
    <div class="split reveal">
      <div class="wl-mock a">
        <div class="wl-logo"><span class="wl-dot"></span> Atelier Nine</div>
        <div class="f" style="font-size:11px;color:#8A7F72;margin-bottom:6px;">Κινητό τηλέφωνο</div>
        <div class="wl-field"></div>
        <div class="wl-field"></div>
      </div>
      <div class="wl-mock b">
        <div class="wl-logo"><span class="wl-dot"></span> Studio Marlow</div>
        <div class="f" style="font-size:11px;color:#9aa0a6;margin-bottom:6px;">Κινητό τηλέφωνο</div>
        <div class="wl-field"></div>
        <div class="wl-field"></div>
      </div>
    </div>
  </div>
</section>
