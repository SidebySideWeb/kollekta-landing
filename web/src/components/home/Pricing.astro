---
import type { HomePage } from '../../lib/types';

interface Props {
  home: HomePage;
}

const { home } = Astro.props;
const plans = home.pricingPlans || [];
---

<section id="pricing">
  <div class="wrap">
    {home.pricingEyebrow && <div class="eyebrow reveal">{home.pricingEyebrow}</div>}
    {home.pricingTitle && <h2 class="h2 reveal">{home.pricingTitle}</h2>}
    <div class="price-grid">
      {
        plans.map((plan) => (
          <div class:list={['card', 'price-card', 'reveal', { pro: plan.highlighted }]}>
            {plan.highlighted && plan.highlightLabel && (
              <span class="pill pill-popular" style="align-self:flex-start; margin-bottom:12px;">
                {plan.highlightLabel}
              </span>
            )}
            <div class="price-name">{plan.name}</div>
            <div class="price-amt">
              {plan.price}
              {plan.period && (
                <span style="font-size:14px;font-weight:600;color:var(--muted);">{plan.period}</span>
              )}
            </div>
            {plan.billingNote && <div class="price-sub">{plan.billingNote}</div>}
            {plan.tagline && <div class="price-tag">{plan.tagline}</div>}
            <ul class="price-feats">
              {(plan.features || []).map((f) => (
                <li>
                  {f.text}
                  {f.soonBadge && <span class="pill pill-soon">Σύντομα</span>}
                </li>
              ))}
            </ul>
            <a
              href="#interest"
              class:list={['btn', plan.highlighted ? 'btn-primary' : 'btn-ghost']}
              data-select-plan={plan.name}
            >
              {plan.ctaLabel || `Επίλεξε ${plan.name}`}
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>
