---
import type { HomePage } from '../../lib/types';

interface Props {
  home: HomePage;
}

const { home } = Astro.props;
const cards = home.audienceCards || [];
const [lead, ...rest] = cards;
---

<section id="who">
  <div class="wrap">
    {home.audienceEyebrow && <div class="eyebrow reveal">{home.audienceEyebrow}</div>}
    {home.audienceTitle && <h2 class="h2 reveal">{home.audienceTitle}</h2>}
    <div class="who-grid">
      {
        lead && (
          <div class="card who-card lead reveal">
            <div class="who-icon" style="font-size:22px;">{lead.icon || '👗'}</div>
            <div>
              <span class="micro-tag">{lead.footer || 'Κύριο use case'}</span>
              <h3>{lead.title}</h3>
              <p>{lead.description}</p>
            </div>
          </div>
        )
      }
      {
        rest.length > 0 && (
          <div class="who-row">
            {rest.map((card) => (
              <div class="card who-card hoverable reveal">
                <div class="who-icon">{card.icon || '📷'}</div>
                <h3>{card.title}</h3>
                <p>{card.description}</p>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>
