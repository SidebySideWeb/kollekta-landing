---
import type { HomePage } from '../../lib/types';

interface Props {
  home: HomePage;
}

const { home } = Astro.props;
const collection = home.heroMockupCollection || 'Summer 2026';
---

<section class="hero">
  <div class="wrap hero-grid">
    <div class="reveal">
      {home.heroBadge && <div class="eyebrow">{home.heroBadge}</div>}
      <h1>{home.heroTitle}</h1>
      <p class="lede">{home.heroDescription}</p>
      <div class="hero-ctas">
        <a href="#interest" class="btn btn-primary">{home.heroPrimaryCta || 'Εκδήλωσε ενδιαφέρον'}</a>
        <a href="#pricing" class="btn btn-ghost">{home.heroSecondaryCta || 'Δες τα πακέτα'}</a>
      </div>
      {home.heroTrustLine && <div class="trust">{home.heroTrustLine}</div>}
    </div>
    <div class="reveal">
      <div class="mock">
        <div class="mock-bar">
          <div class="mock-dots"><span></span><span></span><span></span></div>
          <div class="mock-label">{collection}</div>
        </div>
        <div class="tile-grid">
          <div class="tile"></div>
          <div class="tile sel"><div class="check">✓</div></div>
          <div class="tile"></div>
          <div class="tile sel"><div class="check">✓</div></div>
          <div class="tile"></div>
          <div class="tile"></div>
        </div>
        <div class="selbar"><span class="count">2 επιλεγμένες</span><span class="go">Λήψη</span></div>
      </div>
    </div>
  </div>
</section>
