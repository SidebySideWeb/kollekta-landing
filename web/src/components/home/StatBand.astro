---
import type { HomePage } from '../../lib/types';

interface Props {
  home: HomePage;
}

const { home } = Astro.props;
---

<section class="w-full py-20 md:py-28 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-blue-50/70 via-studio-mist to-white border-y border-slate-hairline">
  <div class="reveal max-w-4xl mx-auto text-center flex flex-col items-center">
    {
      home.statEyebrow && (
        <span class="text-xs font-bold text-cobalt-blue uppercase tracking-widest block mb-4">
          {home.statEyebrow}
        </span>
      )
    }

    <div
      class="text-5xl sm:text-7xl md:text-8xl lg:text-9xl font-extrabold text-cobalt-blue tracking-tight leading-none mb-6 select-none drop-shadow-sm"
      data-count-up={home.statValue ?? '100+'}
    >
      0
    </div>

    <div class="text-2xl sm:text-3xl md:text-4xl font-bold text-deep-slate mb-6">
      {home.statLabel ?? ''}
    </div>

    {
      home.statDescription && (
        <p class="text-base sm:text-lg text-body-ink leading-relaxed max-w-2xl mb-8">
          {home.statDescription}
        </p>
      )
    }

    {
      home.statDisclaimer && (
        <p class="text-xs text-muted-caption italic max-w-xl">{home.statDisclaimer}</p>
      )
    }
  </div>
</section>
