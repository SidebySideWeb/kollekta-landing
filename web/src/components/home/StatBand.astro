---
import type { HomePage } from '../../lib/types';

interface Props {
  home: HomePage;
}

const { home } = Astro.props;
const rows = home.statBreakdown || [];
---

<section id="how" style="background:var(--paper-dim);">
  <div class="wrap">
    {home.statEyebrow && <div class="eyebrow reveal">{home.statEyebrow}</div>}
    {home.statLabel && <h2 class="h2 reveal">{home.statLabel}</h2>}
    <div class="stat-section reveal">
      <div class="stat-big" id="statNumber">{home.statValue || '100+'}</div>
      {
        home.statBigNumberLabel && (
          <div style="font-size:19px; font-weight:700; margin-top:4px;">{home.statBigNumberLabel}</div>
        )
      }
      {home.statMoneyValue && <div class="stat-money">{home.statMoneyValue}</div>}
      {
        home.statDescription && (
          <p style="color:#E7DFD2; max-width:620px; margin-top:20px; font-size:15px;">
            {home.statDescription}
          </p>
        )
      }
      {
        rows.length > 0 && (
          <div class="breakdown">
            {rows.map((row) => (
              <div class="bd-row">
                <div class="bd-label">{row.label}</div>
                <div class="bd-track">
                  <div class="bd-fill" style={`width:${row.percentOfMax ?? 0}%;`} />
                </div>
                <div class="bd-val">{row.hoursLabel || (row.hours != null ? `~${row.hours}ω` : '')}</div>
              </div>
            ))}
          </div>
        )
      }
      {home.statDisclaimer && <div class="stat-disclaimer">{home.statDisclaimer}</div>}
    </div>
  </div>
</section>
