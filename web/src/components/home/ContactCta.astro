---
import InterestForm from '../InterestForm.astro';
import type { HomePage } from '../../lib/types';

interface Props {
  home: HomePage;
}

const { home } = Astro.props;
---

<section id="interest" style="padding-top:0;">
  <div class="cta-band reveal">
    <div class="wrap" style="padding:0;">
      <h2 class="h2">{home.contactTitle || 'Έτοιμος να σταματήσεις να στέλνεις φωτογραφίες με το χέρι;'}</h2>
      {
        home.contactDescription && (
          <p>{home.contactDescription}</p>
        )
      }
    </div>
  </div>
  <div class="form-wrap">
    <InterestForm
      consentText={home.contactConsentText}
      successMessage={home.contactSuccessMessage}
    />
  </div>
</section>
