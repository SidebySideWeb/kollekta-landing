---
import type { HomePage } from '../../lib/types';

interface Props {
  home: HomePage;
}

const { home } = Astro.props;
const items = home.securityItems || [];
---

<section id="security" style="background:var(--paper-dim);">
  <div class="wrap">
    {home.securityEyebrow && <div class="eyebrow reveal">{home.securityEyebrow}</div>}
    {home.securityTitle && <h2 class="h2 reveal">{home.securityTitle}</h2>}
    <div class="sec-grid">
      {
        items.map((item) => (
          <div class="sec-item reveal">
            <div class="sec-icon">{item.icon || '🔐'}</div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
