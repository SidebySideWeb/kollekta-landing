---
import type { HomePage } from '../../lib/types';

interface Props {
  home: HomePage;
}

const { home } = Astro.props;
const cards = home.problemCards || [];
const beforeSteps = home.beforeSteps || [];
const afterSteps = home.afterSteps || [];
---

<section style="background:var(--paper-dim);">
  <div class="wrap">
    {home.problemEyebrow && <div class="eyebrow reveal">{home.problemEyebrow}</div>}
    {home.problemTitle && <h2 class="h2 reveal">{home.problemTitle}</h2>}
    <div class="grid-3">
      {
        cards.map((card) => (
          <div class="card prob-card hoverable reveal">
            <div class="prob-icon">{card.icon || '📎'}</div>
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </div>
        ))
      }
    </div>

    {
      (beforeSteps.length > 0 || afterSteps.length > 0) && (
        <div class="compare reveal">
          <div class="compare-col before">
            <div class="compare-title">{home.beforeTitle || 'Πριν'}</div>
            {beforeSteps.map((step, i) => (
              <div class="step-row">
                <div class="step-dot">{i + 1}</div>
                <div class="step-text">{step}</div>
              </div>
            ))}
            {home.beforeFootnote && <div class="compare-foot">{home.beforeFootnote}</div>}
          </div>
          <div class="compare-col after">
            <div class="compare-title">{home.afterTitle || 'Με το Kollekta'}</div>
            {afterSteps.map((step, i) => (
              <div class="step-row">
                <div class="step-dot">{i + 1}</div>
                <div class="step-text">{step}</div>
              </div>
            ))}
            {home.afterFootnote && <div class="compare-foot">{home.afterFootnote}</div>}
          </div>
        </div>
      )
    }
  </div>
</section>
