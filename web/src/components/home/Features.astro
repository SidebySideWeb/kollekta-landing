---
import type { HomePage } from '../../lib/types';

interface Props {
  home: HomePage;
}

const { home } = Astro.props;
const features = home.features || [];
---

<section id="features">
  <div class="wrap">
    {home.featuresEyebrow && <div class="eyebrow reveal">{home.featuresEyebrow}</div>}
    {
      home.featuresTitle && (
        <h2 class="h2 reveal" style="margin-bottom:8px;">
          {home.featuresTitle}
        </h2>
      )
    }
  </div>
  <div class="wrap">
    {
      features.map((feat, index) => {
        const rev = index % 2 === 1;
        const visual = feat.visual || 'none';
        return (
          <div class:list={['feature', 'reveal', { rev }]}>
            <div class="feat-copy">
              {feat.code && <div class="feat-num">{feat.code}</div>}
              <h3>
                {feat.title}
                {feat.badge && <span class="pill pill-pro">{feat.badge}</span>}
              </h3>
              <p>{feat.description}</p>
            </div>
            <div class="feat-vis">
              {visual === 'tags' && (
                <div>
                  <div class="tagchips">
                    <span class="tagchip active">Πελάτες</span>
                    <span class="tagchip">Συνεργάτες</span>
                    <span class="tagchip">VIP</span>
                    <span class="tagchip">Εσωτερική ομάδα</span>
                  </div>
                  <div class="reach">Reach: 84 παραλήπτες</div>
                </div>
              )}
              {visual === 'orders' && (
                <div class="lock-compare">
                  <div class="lock-tile" />
                  <div class="lock-tile locked">
                    <span class="badge">🔒</span>
                  </div>
                  <div class="lock-tile" />
                </div>
              )}
              {visual === 'auth' && (
                <div class="login-mock">
                  <div class="f">Κινητό τηλέφωνο</div>
                  <div class="box" />
                  <div class="f">Κωδικός πρόσβασης</div>
                  <div class="box" />
                  <div class="go">Σύνδεση</div>
                </div>
              )}
              {visual === 'resize' && (
                <div class="size-chips">
                  <div class="size-chip">
                    <div class="n">Εκτύπωση</div>
                    <div class="s">~12 MB</div>
                  </div>
                  <div class="size-chip">
                    <div class="n">Eshop</div>
                    <div class="s">~450 KB</div>
                  </div>
                  <div class="size-chip">
                    <div class="n">Grid</div>
                    <div class="s">~180 KB</div>
                  </div>
                  <div class="size-chip">
                    <div class="n">Thumb</div>
                    <div class="s">~40 KB</div>
                  </div>
                </div>
              )}
              {visual === 'time' && (
                <div class="time-icon-row">
                  <div class="time-badge">
                    24
                    <br />
                    /7
                  </div>
                </div>
              )}
            </div>
          </div>
        );
      })
    }
  </div>
</section>
