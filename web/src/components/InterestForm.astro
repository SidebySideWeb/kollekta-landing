---
interface Props {
  consentText?: string;
  successMessage?: string;
  defaultPlan?: string;
}

const {
  consentText = 'Συναινώ να επικοινωνήσετε μαζί μου σχετικά με το Kollekta. *',
  successMessage = 'Ευχαριστούμε! Θα επικοινωνήσουμε μαζί σου σύντομα.',
  defaultPlan = 'Pro',
} = Astro.props;
---

<div class="form-card">
  <form id="interestForm">
    <div class="form-group-title">Στοιχεία εταιρείας</div>
    <div class="field">
      <label for="companyName">Επωνυμία εταιρείας *</label>
      <input id="companyName" name="companyName" type="text" required placeholder="π.χ. Atelier Nine" />
    </div>
    <div class="field">
      <label>Λογότυπο εταιρείας</label>
      <div class="field-file">📎 Μπορεί να προστεθεί και αργότερα</div>
    </div>
    <div class="field">
      <label>Πακέτο ενδιαφέροντος *</label>
      <input type="hidden" id="selectedPlan" name="plan" value={defaultPlan} />
      <div class="plan-options" id="planOptions">
        <button type="button" class="plan-opt" data-plan="Basic" data-select-plan="Basic">Basic</button>
        <button type="button" class="plan-opt active" data-plan="Pro" data-select-plan="Pro">Pro</button>
        <button type="button" class="plan-opt" data-plan="Business" data-select-plan="Business">
          Business
        </button>
        <button type="button" class="plan-opt" data-plan="?" data-select-plan="?">Δεν ξέρω ακόμα</button>
      </div>
    </div>

    <div class="form-group-title">Στοιχεία υπεύθυνου λογαριασμού</div>
    <div class="field">
      <label for="fullName">Ονοματεπώνυμο *</label>
      <input id="fullName" name="fullName" type="text" required />
    </div>
    <div class="field">
      <label for="email">Email *</label>
      <input id="email" name="email" type="email" required />
    </div>
    <div class="field">
      <label for="phone">Τηλέφωνο *</label>
      <input id="phone" name="phone" type="tel" required />
    </div>

    <label class="consent">
      <input type="checkbox" name="consent" required />
      {consentText}
    </label>
    <p id="formError" style="display:none;color:#B5451C;font-size:13px;margin:0 0 12px;font-weight:600;"></p>
    <button type="submit" class="submit-btn" id="submitBtn">Αποστολή αίτησης</button>
  </form>
  <div id="success-state">
    <div class="check">✓</div>
    <h3 style="font-size:19px; margin-bottom:8px;">{successMessage}</h3>
    <p style="font-size:14px; color:var(--muted);">Θα λάβεις σύντομα email επιβεβαίωσης.</p>
  </div>
</div>

<script>
  const form = document.getElementById('interestForm') as HTMLFormElement | null;
  const success = document.getElementById('success-state');
  const errorEl = document.getElementById('formError');
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !success || !submitBtn) return;

    const data = new FormData(form);
    const plan = String(data.get('plan') || 'Pro');
    const planUnsure = plan === '?';

    if (errorEl) {
      errorEl.style.display = 'none';
      errorEl.textContent = '';
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Αποστολή…';

    try {
      const res = await fetch('/api/interest', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          companyName: data.get('companyName'),
          fullName: data.get('fullName'),
          email: data.get('email'),
          phone: data.get('phone'),
          plan: planUnsure ? 'Δεν ξέρω ακόμα' : plan,
          planUnsure,
          consent: data.get('consent') === 'on',
        }),
      });

      const payload = await res.json().catch(() => ({}));
      if (!res.ok) {
        throw new Error(payload.error || 'Αποτυχία αποστολής.');
      }

      form.style.display = 'none';
      success.style.display = 'block';
    } catch (err) {
      if (errorEl) {
        errorEl.textContent = err instanceof Error ? err.message : 'Αποτυχία αποστολής.';
        errorEl.style.display = 'block';
      }
      submitBtn.disabled = false;
      submitBtn.textContent = 'Αποστολή αίτησης';
    }
  });
</script>

<style>
  .plan-opt {
    font-family: inherit;
    background: transparent;
  }
</style>
