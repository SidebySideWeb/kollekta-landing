---
import LogoMark from './LogoMark.astro';
import type { SiteSettings } from '../lib/types';

interface Props {
  settings: SiteSettings;
  variant?: 'default' | 'minimal';
  /** Prefix for hash links when not on home (`/` → `/#features`). */
  homePrefix?: string;
}

const { settings, variant = 'default', homePrefix = '' } = Astro.props;

const navLinks = settings.navLinks?.length
  ? settings.navLinks
  : [
      { label: 'Λειτουργίες', href: '#features' },
      { label: 'Πώς λειτουργεί', href: '#how' },
      { label: 'Για ποιον είναι', href: '#who' },
      { label: 'Τιμές', href: '#pricing' },
    ];

const ctaLabel = settings.headerCtaLabel || 'Εκδήλωσε ενδιαφέρον';
const ctaHref = settings.headerCtaHref || '#interest';
const tagline = settings.tagline || 'CURATED MEDIA DELIVERY';

function resolveHref(href: string) {
  if (!href.startsWith('#')) return href;
  return `${homePrefix}${href}`;
}
---

<header class="site" id="siteHeader">
  <div class="wrap nav">
    <a class="brand" href={homePrefix || '#top'}>
      <LogoMark size={38} />
      <span>
        <span class="word">{settings.siteName || 'Kollekta'}</span>
        <div class="tag">{tagline}</div>
      </span>
    </a>
    {
      variant !== 'minimal' && (
        <>
          <nav class="nav-links" aria-label="Κύρια πλοήγηση">
            {navLinks.map((link) => (
              <a href={resolveHref(link.href || '#')}>{link.label}</a>
            ))}
          </nav>
          <a href={resolveHref(ctaHref)} class="btn btn-primary">
            {ctaLabel}
          </a>
        </>
      )
    }
  </div>
</header>
