---
import LogoMark from './LogoMark.astro';
import type { SiteSettings } from '../lib/types';

interface Props {
  settings: SiteSettings;
  variant?: 'full' | 'minimal';
  homePrefix?: string;
}

const { settings, variant = 'full', homePrefix = '' } = Astro.props;

const productLinks = settings.productLinks?.length
  ? settings.productLinks
  : [
      { label: 'Λειτουργίες', href: '#features' },
      { label: 'Τιμές', href: '#pricing' },
      { label: 'Ασφάλεια', href: '#security' },
    ];

const companyLinks = settings.companyLinks?.length
  ? settings.companyLinks
  : [{ label: 'Επικοινωνία', href: '#interest' }];

const legalLinks = settings.legalLinks?.length
  ? settings.legalLinks
  : [
      { label: 'Όροι χρήσης', href: '/terms' },
      { label: 'Πολιτική απορρήτου', href: '/privacy' },
    ];

function resolveHref(href: string) {
  if (!href.startsWith('#')) return href;
  return `${homePrefix}${href}`;
}
---

{
  variant === 'minimal' ? (
    <footer class="footer-minimal">
      <span>{settings.copyright || '© 2026 Kollekta.'}</span>
      <a
        class="sbs-credit"
        href={settings.studioCreditHref || 'https://www.sidebysideweb.gr'}
        target="_blank"
        rel="noopener"
      >
        {settings.studioCredit || 'Product by Side by Side Web →'}
      </a>
    </footer>
  ) : (
    <footer>
      <div class="wrap">
        <div class="foot-grid">
          <div class="foot-col">
            <a class="brand" href={homePrefix || '#top'} style="margin-bottom:10px;">
              <LogoMark size={30} />
              <span>
                <span class="word" style="font-size:18px;">{settings.siteName || 'Kollekta'}</span>
              </span>
            </a>
            <p style="font-size:13px; color:var(--muted); max-width:220px;">
              {settings.footerDescription ||
                'Curated media delivery για επιχειρήσεις και επαγγελματίες.'}
            </p>
          </div>
          <div class="foot-col">
            <h4>Προϊόν</h4>
            {productLinks.map((link) => (
              <a href={resolveHref(link.href || '#')}>{link.label}</a>
            ))}
          </div>
          <div class="foot-col">
            <h4>Εταιρεία</h4>
            {companyLinks.map((link) => (
              <a href={resolveHref(link.href || '#')}>{link.label}</a>
            ))}
          </div>
          <div class="foot-col">
            <h4>Νομικά</h4>
            {legalLinks.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
          </div>
        </div>
        <div class="foot-bottom">
          <span>{settings.copyright || '© 2026 Kollekta. Με επιφύλαξη κάθε δικαιώματος.'}</span>
          <a
            class="sbs-credit"
            href={settings.studioCreditHref || 'https://www.sidebysideweb.gr'}
            target="_blank"
            rel="noopener"
          >
            {settings.studioCredit || 'Product by Side by Side Web →'}
          </a>
        </div>
      </div>
    </footer>
  )
}
